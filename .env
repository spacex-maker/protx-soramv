# Disable sourcemap generation (50% faster)
GENERATE_SOURCEMAP=false

# Disable ESLint plugin (20% faster)
DISABLE_ESLINT_PLUGIN=true

# Skip preflight check
SKIP_PREFLIGHT_CHECK=true

# Enable fast refresh
FAST_REFRESH=true

# 防止改代码时进程退出：用轮询代替原生文件监听，避免 Windows 下 chokidar 触发的崩溃
CHOKIDAR_USEPOLLING=true
# 可选：轮询间隔(ms)，若仍崩可改为 1000
# CHOKIDAR_INTERVAL=500
# 可选：加大 Node 内存，减少 0xC0000006 等崩溃
# NODE_OPTIONS=--max-old-space-size=4096
